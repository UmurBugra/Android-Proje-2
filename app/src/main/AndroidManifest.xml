<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CLearn">

        <!-- Giriş Ekranı (Launcher) -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CLearn">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Öğrenci Paneli -->
        <activity
            android:name=".ui.student.StudentDashboardActivity"
            android:exported="false"
            android:label="@string/student_dashboard_title"
            android:theme="@style/Theme.CLearn" />

        <!-- Öğretmen Paneli -->
        <activity
            android:name=".ui.teacher.TeacherDashboardActivity"
            android:exported="false"
            android:label="@string/teacher_dashboard_title"
            android:theme="@style/Theme.CLearn" />

        <!-- Sınıf Detayı -->
        <activity
            android:name=".ui.classroom.ClassroomDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.CLearn" />

        <!-- Vaka Simülasyonu -->
        <activity
            android:name=".ui.simulation.CaseSimulationActivity"
            android:exported="false"
            android:theme="@style/Theme.CLearn" />

    </application>

</manifest>