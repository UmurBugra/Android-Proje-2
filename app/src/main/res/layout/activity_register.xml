<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_primary">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_l">

        <!-- Başlık Alanı -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register_title"
            style="@style/TextStyle.Title"
            android:textSize="36sp"
            android:layout_marginTop="@dimen/spacing_l"
            android:layout_marginBottom="@dimen/spacing_s"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register_subtitle"
            style="@style/TextStyle.Caption"
            android:layout_marginBottom="@dimen/spacing_xxl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- Kullanıcı Adı Input -->
        <EditText
            android:id="@+id/etUsername"
            android:layout_width="0dp"
            style="@style/InputStyle"
            android:hint="@string/hint_username"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionNext"
            android:autofillHints="username"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:layout_marginBottom="@dimen/spacing_m"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintWidth_max="360dp" />

        <!-- Şifre Input -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="0dp"
            style="@style/InputStyle"
            android:hint="@string/hint_password"
            android:inputType="textPassword"
            android:maxLines="1"
            android:imeOptions="actionNext"
            android:autofillHints="password"
            android:layout_marginBottom="@dimen/spacing_m"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etUsername"
            app:layout_constraintWidth_max="360dp" />

        <!-- Şifre Tekrar Input -->
        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="0dp"
            style="@style/InputStyle"
            android:hint="@string/hint_confirm_password"
            android:inputType="textPassword"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:autofillHints="password"
            android:layout_marginBottom="@dimen/spacing_m"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etPassword"
            app:layout_constraintWidth_max="360dp" />

        <!-- Rol Seçimi -->
        <TextView
            android:id="@+id/tvRoleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint_role"
            style="@style/TextStyle.Body"
            android:layout_marginTop="@dimen/spacing_m"
            app:layout_constraintStart_toStartOf="@id/etUsername"
            app:layout_constraintTop_toBottomOf="@id/etConfirmPassword" />

        <RadioGroup
            android:id="@+id/rgRole"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_s"
            android:layout_marginBottom="@dimen/spacing_l"
            app:layout_constraintEnd_toEndOf="@id/etUsername"
            app:layout_constraintStart_toStartOf="@id/etUsername"
            app:layout_constraintTop_toBottomOf="@id/tvRoleLabel">

            <RadioButton
                android:id="@+id/rbStudent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/role_student"
                android:checked="true"
                style="@style/TextStyle.Body" />

            <RadioButton
                android:id="@+id/rbTeacher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/role_teacher"
                style="@style/TextStyle.Body" />

        </RadioGroup>

        <!-- Kayıt Ol Butonu -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="0dp"
            style="@style/Button.Accent"
            android:text="@string/btn_register"
            android:layout_marginTop="@dimen/spacing_l"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rgRole"
            app:layout_constraintWidth_max="360dp" />

        <!-- Hata Mesajı -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/error"
            android:textSize="@dimen/text_size_caption"
            android:visibility="gone"
            android:layout_marginTop="@dimen/spacing_m"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnRegister" />

        <!-- Giriş Yap Linki -->
        <TextView
            android:id="@+id/tvLoginPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/have_account"
            style="@style/TextStyle.Caption"
            android:layout_marginTop="@dimen/spacing_l"
            app:layout_constraintEnd_toStartOf="@id/tvLoginLink"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvError" />

        <TextView
            android:id="@+id/tvLoginLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_login"
            android:textColor="@color/accent"
            style="@style/TextStyle.Caption"
            android:layout_marginStart="@dimen/spacing_xs"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvLoginPrompt"
            app:layout_constraintTop_toTopOf="@id/tvLoginPrompt" />

        <!-- Yükleniyor Göstergesi -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminateTint="@color/accent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>

