<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:padding="@dimen/spacing_l">

    <!-- Logo/Başlık Alanı -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_title"
        style="@style/TextStyle.Title"
        android:textSize="36sp"
        android:layout_marginBottom="@dimen/spacing_s"
        app:layout_constraintBottom_toTopOf="@id/tvSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_subtitle"
        style="@style/TextStyle.Caption"
        android:layout_marginBottom="@dimen/spacing_s"
        app:layout_constraintBottom_toTopOf="@id/tvDemoAccounts"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Demo Hesap Bilgileri -->
    <TextView
        android:id="@+id/tvDemoAccounts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/demo_accounts"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:padding="@dimen/spacing_s"
        android:background="#1A000000"
        android:layout_marginBottom="@dimen/spacing_l"
        app:layout_constraintBottom_toTopOf="@id/etUsername"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

    <!-- Kullanıcı Adı Input -->
    <EditText
        android:id="@+id/etUsername"
        android:layout_width="0dp"
        style="@style/InputStyle"
        android:hint="@string/hint_username"
        android:inputType="text"
        android:maxLines="1"
        android:imeOptions="actionNext"
        android:autofillHints="username"
        android:layout_marginBottom="@dimen/spacing_m"
        app:layout_constraintBottom_toTopOf="@id/etPassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDemoAccounts"
        app:layout_constraintWidth_max="360dp" />

    <!-- Şifre Input -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="0dp"
        style="@style/InputStyle"
        android:hint="@string/hint_password"
        android:inputType="textPassword"
        android:maxLines="1"
        android:imeOptions="actionDone"
        android:autofillHints="password"
        android:layout_marginBottom="@dimen/spacing_l"
        app:layout_constraintBottom_toTopOf="@id/btnLogin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etUsername"
        app:layout_constraintWidth_max="360dp" />

    <!-- Giriş Yap Butonu -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="0dp"
        style="@style/Button.Accent"
        android:text="@string/btn_login"
        android:layout_marginBottom="@dimen/spacing_m"
        app:layout_constraintBottom_toTopOf="@id/btnRegister"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etPassword"
        app:layout_constraintWidth_max="360dp" />

    <!-- Kayıt Ol Butonu -->
    <Button
        android:id="@+id/btnRegister"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_register"
        android:textColor="@color/accent"
        android:background="@android:color/transparent"
        android:textSize="@dimen/text_size_body"
        app:layout_constraintBottom_toTopOf="@id/tvError"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnLogin"
        app:layout_constraintWidth_max="360dp" />

    <!-- Hata Mesajı -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/error"
        android:textSize="@dimen/text_size_caption"
        android:visibility="gone"
        android:layout_marginTop="@dimen/spacing_m"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnRegister" />

    <!-- Yükleniyor Göstergesi -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
