<?xml version="1.0" encoding="utf-8"?>
<!-- Dieter Rams Stili - Minimal Çerçeveli Buton -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/background_input"/>
            <stroke android:width="1dp" android:color="@color/text_secondary"/>
            <corners android:radius="@dimen/corner_radius_small"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background_secondary"/>
            <stroke android:width="1dp" android:color="@color/border"/>
            <corners android:radius="@dimen/corner_radius_small"/>
        </shape>
    </item>
</selector>


